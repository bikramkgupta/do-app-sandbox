# GitHub Container Registry (GHCR) Configuration
# Copy this to .env and fill in your values

# Your GitHub username or organization
GHCR_OWNER=bikramkgupta

# GitHub username for login (usually same as GHCR_OWNER)
GHCR_USER=bikramkgupta

# Personal Access Token with write:packages scope
# Create at: https://github.com/settings/tokens/new
# Required scopes: write:packages, read:packages
GHCR_PAT=ghp_your_token_here

# Optional: DigitalOcean settings for SDK
# DIGITALOCEAN_TOKEN=dop_v1_xxx
# APP_SANDBOX_REGION=atl1

# Optional: DigitalOcean Spaces for large file transfers (>5MB)
# Required for filesystem.upload_large() / download_large()
# SPACES_ENDPOINT=https://your-bucket.nyc3.digitaloceanspaces.com
# SPACES_ACCESS_KEY=DO00XXXXXXXXXX
# SPACES_SECRET_KEY=your_secret_key_here
# SPACES_BUCKET=your-bucket-name
# SPACES_REGION=nyc3
