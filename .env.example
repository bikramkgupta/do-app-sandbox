# DO App Sandbox - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DigitalOcean API (Required for SDK usage)
# =============================================================================
DIGITALOCEAN_TOKEN=dop_v1_your_token_here

# =============================================================================
# Container Registry (Optional - defaults to public GHCR images)
# =============================================================================
# GHCR_OWNER=your-github-username
# GHCR_USER=your-github-username
# GHCR_PAT=ghp_your_personal_access_token

# =============================================================================
# Sandbox Configuration (Optional)
# =============================================================================
# APP_SANDBOX_REGION=syd1
# APP_SANDBOX_PYTHON_TAG=latest

# =============================================================================
# DO Spaces (Required for snapshots and large file transfers >= 5MB)
# =============================================================================
SPACES_BUCKET=your-bucket-name
SPACES_REGION=nyc3
SPACES_ACCESS_KEY=your_access_key
SPACES_SECRET_KEY=your_secret_key

# =============================================================================
# Container API Tests (Optional - for testing sandbox_api endpoints)
# =============================================================================
# SANDBOX_API_URL=https://your-sandbox.ondigitalocean.app
# SANDBOX_API_TOKEN=your-service-token
